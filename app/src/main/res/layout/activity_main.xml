<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <!-- Verse Card with ID added for Night Mode -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/verseCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_margin="20dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#FFFFFF"
        app:strokeWidth="1dp"
        app:strokeColor="#E8E2D5">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="28dp">

            <!-- Verse Text -->
            <TextView
                android:id="@+id/tvVerseText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="For I know the plans I have for you, declares the Lord..."
                android:textSize="21sp"
                android:textColor="#2D241E"
                android:fontFamily="serif"
                android:lineSpacingMultiplier="1.3"
                android:textStyle="italic" />

            <!-- Verse Reference -->
            <TextView
                android:id="@+id/tvVerseRef"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="— Jeremiah 29:11"
                android:textSize="15sp"
                android:textColor="#8C6D53"
                android:textStyle="bold"
                android:gravity="end" />

            <!-- Action Buttons Row (Equal Width Distribution) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:weightSum="3">
                
                <!-- Copy Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopy"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="💾 Copy"
                    android:textColor="#6E472C"
                    app:strokeColor="#6E472C"
                    android:layout_marginEnd="4dp" />
                
                <!-- Share Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShare"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔗 Share"
                    android:textColor="#6E472C"
                    app:strokeColor="#6E472C"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp" />

                <!-- Speak Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSpeak"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔊 Speak"
                    android:textColor="#6E472C"
                    app:strokeColor="#6E472C"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <!-- New Random Bible Verse Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRefresh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="🔀 New Random Bible Verse"
                android:textSize="16sp"
                android:paddingVertical="12dp"
                app:backgroundTint="#6E472C"
                app:cornerRadius="12dp" />

            <!-- Choose Bible Chapter & Verse Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelectManual"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="📖 Choose Bible Chapter &amp; Verse"
                android:textColor="#6E472C"
                app:strokeColor="#6E472C"
                app:cornerRadius="12dp" />

            <!-- Theme Toggle Button (Day / Night View) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleTheme"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="🌙 Switch to Night View"
                android:textColor="#6E472C"
                app:strokeColor="#6E472C"
                app:cornerRadius="12dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</RelativeLayout>
