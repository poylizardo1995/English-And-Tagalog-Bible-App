<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">
    
    <!-- Live Animated Biblical Background Layer -->
    <com.example.EnglishTagalogBible.BiblicalAnimationBackgroundView
        android:id="@+id/animatedBackgroundView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Verse Card set with a slight transparency so background animation shows through -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/verseCard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="16dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#F2FFFFFF"
        app:strokeWidth="1dp"
        app:strokeColor="#E8E2D5">

        <!-- ScrollView added to eliminate vertical overflow and overlapping -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="28dp">

                <!-- Language Toggle Pill -->
                <include
                    android:id="@+id/languageTogglePill"
                    layout="@layout/layout_language_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="16dp" />

                <!-- Verse Text -->
                <TextView
                    android:id="@+id/tvVerseText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="For I know the plans I have for you, declares the Lord..."
                    android:textSize="21sp"
                    android:textColor="#2D241E"
                    android:fontFamily="serif"
                    android:lineSpacingMultiplier="1.3"
                    android:textStyle="italic" />

                <!-- Verse Reference -->
                <TextView
                    android:id="@+id/tvVerseRef"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="— Jeremiah 29:11"
                    android:textSize="15sp"
                    android:textColor="#8C6D53"
                    android:textStyle="bold"
                    android:gravity="end" />

                <!-- Compact Action Buttons Row: Copy, Share, Listen -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCopy"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="💾 Copy"
                        android:textSize="12sp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:paddingHorizontal="2dp"
                        android:textColor="#6E472C"
                        app:strokeColor="#6E472C"
                        android:layout_marginEnd="2dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnShare"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🔗 Share"
                        android:textSize="12sp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:paddingHorizontal="2dp"
                        android:textColor="#6E472C"
                        app:strokeColor="#6E472C"
                        android:layout_marginStart="2dp"
                        android:layout_marginEnd="2dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSpeak"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🔊 Listen"
                        android:textSize="12sp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:paddingHorizontal="2dp"
                        android:textColor="#6E472C"
                        app:strokeColor="#6E472C"
                        android:layout_marginStart="2dp" />
                </LinearLayout>

                <!-- Navigation Row (Previous & Next Verse) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPrev"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="◀ Prev Verse"
                        android:textSize="12sp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:textColor="#6E472C"
                        app:strokeColor="#6E472C"
                        android:layout_marginEnd="2dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnNext"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Next Verse ▶"
                        android:textSize="12sp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:textColor="#6E472C"
                        app:strokeColor="#6E472C"
                        android:layout_marginStart="2dp" />
                </LinearLayout>

                <!-- Auto-Play Continuous Listen Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAutoPlay"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="▶ Auto-Play"
                    android:textSize="14sp"
                    android:textColor="#6E472C"
                    app:strokeColor="#6E472C"
                    app:cornerRadius="12dp" />

                <!-- PRIMARY ACTION BUTTON 1: New Random Verse (Filled Style) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRefresh"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="🔀 New Random Bible Verse"
                    android:textSize="15sp"
                    android:paddingVertical="12dp"
                    app:backgroundTint="#6E472C"
                    app:cornerRadius="12dp" />

                <!-- PRIMARY ACTION BUTTON 2: Search Bible (Filled Style Uniform with Random) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="🔍 Search Bible"
                    android:textAllCaps="false"
                    android:textSize="15sp"
                    android:paddingVertical="12dp"
                    app:backgroundTint="#6E472C"
                    app:cornerRadius="12dp" />

                <!-- Choose Chapter & Verse Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelectManual"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="📖 Choose Bible Chapter &amp; Verse"
                    android:textColor="#6E472C"
                    app:strokeColor="#6E472C"
                    app:cornerRadius="12dp" />

                <!-- Centralized Settings & Themes Dialog Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSettings"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="⚙️ Settings &amp; Themes"
                    android:textColor="#6E472C"
                    app:strokeColor="#6E472C"
                    app:cornerRadius="12dp" />

                <!-- About & Credits Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAbout"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="4dp"
                    android:text="ℹ️ About &amp; Credits"
                    android:textColor="#6E472C"
                    app:strokeColor="#6E472C"
                    app:cornerRadius="12dp" />

            </LinearLayout>
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>
</RelativeLayout>
